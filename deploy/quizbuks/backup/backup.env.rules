# tools/ops/env-check.sh --app-only backup.env deploy/quizbuks/backup/backup.env.rules
set PGBACKREST_REPO1_S3_ENDPOINT
set PGBACKREST_REPO1_S3_BUCKET
set PGBACKREST_REPO1_S3_KEY
set PGBACKREST_REPO1_S3_KEY_SECRET
min-length PGBACKREST_REPO1_CIPHER_PASS 32
set PGBACKREST_REPO2_S3_ENDPOINT
set PGBACKREST_REPO2_S3_BUCKET
set PGBACKREST_REPO2_S3_KEY
set PGBACKREST_REPO2_S3_KEY_SECRET
min-length PGBACKREST_REPO2_CIPHER_PASS 32
set RESTIC_REPOSITORY
min-length RESTIC_PASSWORD 32
set AWS_ACCESS_KEY_ID
set AWS_SECRET_ACCESS_KEY
set FILES_VOLUME
# Three different passphrases: one leaked does not open the others.
different PGBACKREST_REPO1_CIPHER_PASS PGBACKREST_REPO2_CIPHER_PASS
different PGBACKREST_REPO1_CIPHER_PASS RESTIC_PASSWORD
different PGBACKREST_REPO2_CIPHER_PASS RESTIC_PASSWORD
# Someone must hear about a failure: the mail, and better also the pings.
set BACKUP_MAIL_SMTP_URL
set BACKUP_MAIL_FROM
set BACKUP_MAIL_TO
warn-unset BACKUP_PING_URL_PITR
