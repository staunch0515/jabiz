# Backups of the shared PostgreSQL (pgBackRest) and of production's uploaded files (restic), to Cloudflare R2
# (deploy/quizbuks/DEPLOY.md, "备份"). Copy to /opt/infra/backup/backup.env, chmod 600, root only. Never commit the
# filled-in file. Check it: tools/ops/env-check.sh --app-only backup.env deploy/quizbuks/backup/backup.env.rules
#
# The two passphrases encrypt the backups: without them a backup cannot be restored. Keep an offline copy of each,
# apart from the backup itself and apart from the JABIZ_* keys.

# R2: https://<account id>.r2.cloudflarestorage.com, the backup bucket, and the backup-only API token.
PGBACKREST_REPO1_S3_ENDPOINT=<account id>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_BUCKET=quizbuks-backup
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# openssl rand -base64 48
PGBACKREST_REPO1_CIPHER_PASS=

PGBACKREST_REPO2_S3_ENDPOINT=<account id>.r2.cloudflarestorage.com
PGBACKREST_REPO2_S3_BUCKET=quizbuks-backup
PGBACKREST_REPO2_S3_KEY=
PGBACKREST_REPO2_S3_KEY_SECRET=
# openssl rand -base64 48 (another one)
PGBACKREST_REPO2_CIPHER_PASS=

# restic: production's uploaded files (volume quizbuks_files), same bucket, its own path.
RESTIC_REPOSITORY=s3:https://<account id>.r2.cloudflarestorage.com/quizbuks-backup/restic-files
# openssl rand -base64 48 (a third one)
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FILES_VOLUME=quizbuks_files

# Who hears about a failed or overdue backup.
# Optional: a dead man's switch (healthchecks.io or the like). The scripts ping <url>/start, <url> and <url>/fail;
# the service tells on-call when a ping is missing or a run failed, which also covers the whole server being down.
BACKUP_PING_URL_PITR=
BACKUP_PING_URL_MONTHLY=
BACKUP_PING_URL_FILES=
BACKUP_PING_URL_CHECK=
# Mail to on-call through an SMTP server (smtps://host:465 or smtp://host:587 with STARTTLS): sent on every failure
# whether or not the pings are set.
BACKUP_MAIL_SMTP_URL=
BACKUP_MAIL_USER=
BACKUP_MAIL_PASSWORD=
BACKUP_MAIL_FROM=
BACKUP_MAIL_TO=
