# The application as the end-to-end tests need it (quizbuks-web/e2e): the one file CI (.github/workflows/quizbuks.yml,
# job e2e-shard) and the local run (tools/quizbuks/e2e.sh) both read, so the two cannot drift. Everything here is
# fixed and secret-free; the keys, the database, the first administrator and the files' root come from the caller.
# LOCAL AND CI ONLY: several of these are refused by a production start (deploy/quizbuks/README.md, "e2e").

# The tests' administrator has no second factor; the publisher of QB_SETUP's proposals and the accountant of the
# journal export are roles of the tests' own (QB_E2E_PUBLISHER: control.publish only; QB_E2E_FINANCE: the export
# without a second factor, Q9d; QB_E2E_CONTENT: publishing the legal texts, with a TOTP set up by the tests, Q7b),
# which the administration therefore accepts here.
JABIZ_SECURITY_MFA_ADMINISTRATION=false
QB_ADMIN_ROLES=ADMIN,QB_ADMIN_SUPER,QB_ADMIN_CONTENT,QB_ADMIN_FINANCE,QB_E2E_PUBLISHER,QB_E2E_FINANCE,QB_E2E_CONTENT
# Every test registers from the same address.
JABIZ_SECURITY_SIGN_UP_RATE_LIMIT_PER_ADDRESS=1000
# And signs in from it, the shared administrator dozens of times (platform 16q, D47): as the platform's e2e.
JABIZ_SECURITY_SIGN_IN_RATE_LIMIT_PER_USER_ADDRESS=6000
JABIZ_SECURITY_SIGN_IN_RATE_LIMIT_USER_BURST=1000
# The daily transfers every minute (Q9c): finance's test waits for a large transfer to need review.
QB_TRANSFER_RUN_CRON='0 * * * * *'
# The daily reconciliation every minute (Q9d): the journal export waits for a clean run after its month.
QB_RECONCILE_RUN_CRON='30 * * * * *'
# The sponsors' analytics every minute (Q9e2): the analytics test waits for its attempts to be counted
# (a privacy control: another schedule needs the end-to-end switch, which live mode refuses).
QB_ANALYTICS_RUN_CRON='15 * * * * *'
QB_E2E_ENABLED=true
# An account deleted by an administrator is erased at the next run of the deletion job (F-S5b: a certificate's number finds
# nothing once its holder's account is gone); the production defaults are 14 days and once a day at 03:41 UTC. The job
# takes the requests due by its scheduled time, so a run asked for by hand only finds a request made before the last one:
# every minute here.
JABIZ_SECURITY_ACCOUNT_DELETION_COOLING_OFF=PT1S
JABIZ_SECURITY_ACCOUNT_DELETION_CRON='30 * * * * *'

# Mail to Mailpit on this machine; links on this host's root, each entry's front end below it.
JABIZ_MAIL_ENABLED=true
JABIZ_MAIL_FROM=noreply@quizbuks.test
JABIZ_MAIL_BASE_URL=http://localhost:8080
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# The sponsors' mail servers of the tests are on this machine, with a throwaway certificate (Q29).
JABIZ_MAIL_SENDERS_TRUST_ALL_FOR_TESTS=true

# Stripe is the stub on this machine (PayoutSettings and CheckoutRequest accept localhost); so is Claude (Q8a).
STRIPE_API_KEY=sk_test_e2e_throwaway
QB_STRIPE_API_URL=http://localhost:8093
QB_STRIPE_API_HOSTS=localhost
QB_STRIPE_CHECKOUT_URL_PREFIX=http://localhost:8093/
QB_STRIPE_CONNECT_URL_PREFIX=http://localhost:8093/
ANTHROPIC_API_KEY=e2e-throwaway-not-a-claude-key
QB_ANTHROPIC_API_URL=http://localhost:8094
QB_ANTHROPIC_API_HOSTS=localhost
# QuizBuks for Shopify (S1): the app's key; nothing calls Shopify (the secret comes from the caller).
SHOPIFY_API_KEY=e2e-throwaway-shopify-key

# The front ends' addresses as the mails and the pages link them.
QB_SPONSOR_LINK=http://localhost:8080/sponsor/
QB_APP_LINK=http://localhost:8080/taker/
