# Optional settings for `docker compose up` (copy to .env; .env is not committed).
# Without them, the app container generates a signing key and an administrator password on first start and keeps
# them in the jabiz-secrets volume (docker/app-entrypoint.sh).
# JABIZ_JWT_SECRET=            # Base64, at least 32 bytes: openssl rand -base64 48
# JABIZ_INTEGRITY_KEY=         # likewise; keep a copy
# JABIZ_MFA_KEY=               # likewise; keep a copy
# JABIZ_DEMO_AI_KEY=           # the demo AI service's key (decision D38); a placeholder is generated without it
# JABIZ_BOOTSTRAP_ADMIN_USER=admin
# JABIZ_BOOTSTRAP_ADMIN_PASSWORD=

# Alerts (docs/design/13-observability-ops.md section 7): who receives them, Grafana's mail server, and the thresholds.
# JABIZ_ALERT_EMAIL=oncall@example.com
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.example.com:587
# GF_SMTP_USER=
# GF_SMTP_PASSWORD=
# GF_SMTP_FROM_ADDRESS=alerts@example.com
# JABIZ_ALERT_DISK_PERCENT=80

# Key rotation (decision D78, docs/guide/key-rotation.md): the retired keys, Base64, comma-separated. Remove the JWT,
# MFA and seal ones when the rotation is over; keep the integrity one for good.
# JABIZ_JWT_SECRET_PREVIOUS=
# JABIZ_MFA_KEY_PREVIOUS=
# JABIZ_SEAL_KEY_PREVIOUS=
# JABIZ_INTEGRITY_KEY_PREVIOUS=
